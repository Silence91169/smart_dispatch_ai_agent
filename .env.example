# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set exactly ONE of the keys below. The system auto-detects which to use.
# Fastest / cheapest for demos: Groq (Llama 3.3 70B, free tier available)

# Option A — Groq (recommended for demos)
GROQ_API_KEY=gsk_your_key_here

# Option B — Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Option C — OpenAI
# OPENAI_API_KEY=sk-your_key_here

# ── LLM Model Selection ───────────────────────────────────────────────────────
# Which provider to use when multiple keys are present.
# Values: groq | anthropic | openai
LLM_PROVIDER=groq

# Model IDs (defaults shown — change if you want a different variant)
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite is the default (zero config). For production, swap to postgres://.
DB_PATH=sqlite+aiosqlite:///./dispatch.db

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
